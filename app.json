{
  "expo": {
    "name": "Synapse Gestion",
    "slug": "synapse-gestion",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vivien542.synapsegestion"
    },
    "android": {
      "package": "com.vivien542.synapsegestion",
      "adaptiveIcon": {
        "backgroundColor": "#0D0D12",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#6C3CFF"
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "97afc70d-ab23-4005-a8bd-ac369f8ce82e"
      }
    },
    "owner": "v3142"
  }
}
